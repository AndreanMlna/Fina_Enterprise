# ==============================================================================
# FINA-ENTERPRISE .gitignore
# Production-Grade Git Ignore Configuration (Google Engineering & OWASP Standards)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL: NEVER COMMIT TO GIT)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx
*.cert
*.crt
id_rsa
id_rsa.pub
*service-account*.json
credentials.json
client_secret*.json
auth_state.json
token.json

# ------------------------------------------------------------------------------
# 2. Virtual Environments & Package Managers
# ------------------------------------------------------------------------------
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
node_modules/
**/node_modules/
.bun/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ------------------------------------------------------------------------------
# 3. Build Outputs, Bundles & Caches
# ------------------------------------------------------------------------------
dist/
**/dist/
dist-ssr/
build/
out/
.next/
.turbo/
.vite/
**/.vite/
*.tsbuildinfo

# ------------------------------------------------------------------------------
# 4. Python Cache & Compilation Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.dll
*.dylib
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# ------------------------------------------------------------------------------
# 5. Logs, Dumps & Local Databases
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.bak

# ------------------------------------------------------------------------------
# 6. Temporary Files & Local Scratch Scripts
# ------------------------------------------------------------------------------
scratch/
**/scratch/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo

# ------------------------------------------------------------------------------
# 7. IDE & Editor Configuration
# ------------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 8. Operating System Artifacts
# ------------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ------------------------------------------------------------------------------
# 9. AI Agent Configurations & Internal Rules (Private Customizations)
# ------------------------------------------------------------------------------
.agents/
AGENTS.md
agents.md
GEMINI.md
gemini.md
