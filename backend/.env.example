# ==============================================================================
# FINA-ENTERPRISE Backend Environment Variables (Template)
# Sesuai Standar: The Twelve-Factor App & OWASP API Security
# Salin berkas ini menjadi '.env' dan sesuaikan dengan kredensial sistem Anda.
# ==============================================================================

# Database Connection (NeonDB Serverless PostgreSQL / Cloud Postgres)
# Gunakan connection string dari Neon Console (Dashboard -> Connection Details).
# Untuk Runtime FastAPI / Vercel Serverless: Gunakan Pooled Connection (-pooler hostname)
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-fog-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Alternatif: Database PostgreSQL Lokal (Fallback jika DATABASE_URL tidak diisi)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ganti_dengan_password_postgres_anda
POSTGRES_DB=fina_enterprise

# Security & Cryptographic Tokens (HMAC-SHA256)
SECRET_KEY=ganti_dengan_random_secret_key_yang_sangat_kuat_min_32_karakter
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Regulatory Compliance (UU PDP No. 27/2022 & IAI SAK EMKM)
ENFORCE_PII_MASKING=True
ENFORCE_DOUBLE_ENTRY_BALANCE=True

# Google Gemini GenAI SDK (Google AI Studio)
# Dapatkan kunci API resmi Anda di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
